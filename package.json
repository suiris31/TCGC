{
  "name": "tcgc",
  "version": "0.1.0",
  "private": true,
  "description": "Gestionnaire de collection One Piece TCG avec scan et estimation des prix",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"node --watch --no-warnings=ExperimentalWarning server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "sync": "node --no-warnings=ExperimentalWarning server/sync.js",
    "index-images": "node --no-warnings=ExperimentalWarning server/scan-index.js",
    "backup": "node --no-warnings=ExperimentalWarning server/backup.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "express": "^5.2.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/suiris31/TCGC.git"
  }
}
