# Réglages privés de TCGC sur le serveur (lus par le service systemd, voir tcgc.service).
# Copie : sudo cp /opt/tcgc/app/deploy/tcgc.env.example /opt/tcgc/tcgc.env
#         sudo chmod 600 /opt/tcgc/tcgc.env   (contient un mot de passe : lisible par root seulement)
# Puis : sudo systemctl restart tcgc

# Adresse publique de l'appli, utilisée dans les liens envoyés par e-mail
PUBLIC_URL=https://exemple.fr/tcgc/

# Envoi d'e-mails (mot de passe oublié) : serveur SMTP de ta messagerie et expéditeur
# ex. OVH : smtps://adresse%40exemple.fr:motdepasse@ssl0.ovh.net:465 (@ s'écrit %40 dans l'identifiant)
SMTP_URL=
MAIL_FROM=Ma Collection <collection@exemple.fr>

# Contact transmis aux services de notification des navigateurs (Web Push)
VAPID_SUBJECT=mailto:contact@exemple.fr

# Mentions légales (page « Mentions légales et confidentialité ») : éditeur, contact, hébergeur (nom et adresse)
# LEGAL_CONTACT est aussi l'adresse donnée aux ayants droit pour une demande de retrait (section « Projet de fan »)
LEGAL_PUBLISHER=
LEGAL_CONTACT=
LEGAL_HOST=

# Interrupteur de retrait (demande d'un ayant droit) : 1 pour couper, vide ou 0 pour remettre en route, puis
#   sudo systemctl restart tcgc
# La collection des membres n'est jamais coupée ; rien n'est effacé de la base.
# Visuels des cartes (collection et jeu) remplacés par une face dessinée par l'appli (nom, numéro, couleur)
TAKEDOWN_IMAGES=
# Jeu (onglet Jouer) fermé : un message à la place ; parties, decks, Cale et progression gardés
TAKEDOWN_GAME=
# Pages publiques (liens de partage, sans compte) fermées
TAKEDOWN_PUBLIC=
