# Service systemd de TCGC sur un serveur Linux (voir README, « Héberger en ligne »).
# Arborescence : code dans /opt/tcgc/app, Node.js 24 privé dans /opt/tcgc/node (n'affecte pas les autres sites)
# Copie : sudo cp /opt/tcgc/app/deploy/tcgc.service /etc/systemd/system/tcgc.service
[Unit]
Description=TCGC - collection One Piece Card Game
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tcgc
Group=tcgc
WorkingDirectory=/opt/tcgc/app
Environment=NODE_ENV=production
Environment=PATH=/opt/tcgc/node/bin:/usr/local/bin:/usr/bin:/bin
# Écoute seulement en local : seul nginx (même machine) peut joindre l'appli
Environment=HOST=127.0.0.1
Environment=PORT=3001
# Sous-dossier public de l'appli (https://exemple.fr/tcgc) ; laisser vide si servie à la racine d'un domaine
Environment=PUBLIC_PATH=/tcgc
# Réglages privés (e-mails, adresse publique...) hors du dépôt : voir deploy/tcgc.env.example ("-" : facultatif)
EnvironmentFile=-/opt/tcgc/tcgc.env
ExecStart=/opt/tcgc/node/bin/node --no-warnings=ExperimentalWarning server/index.js
Restart=on-failure
RestartSec=5

# Serveur partagé avec d'autres sites : TCGC passe après eux pour le processeur et les disques
Nice=10
CPUWeight=50
IOWeight=50

# Durcissement : l'appli ne peut écrire que dans son dossier
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/tcgc

[Install]
WantedBy=multi-user.target
